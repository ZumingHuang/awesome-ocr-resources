{
  "$defs": {
    "Curation": {
      "additionalProperties": true,
      "properties": {
        "status": {
          "$ref": "#/$defs/CurationStatus"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "relevance_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance Score"
        }
      },
      "required": [
        "status"
      ],
      "title": "Curation",
      "type": "object"
    },
    "CurationStatus": {
      "enum": [
        "candidate",
        "needs-review",
        "verified",
        "stale",
        "archived"
      ],
      "title": "CurationStatus",
      "type": "string"
    },
    "DatePrecision": {
      "enum": [
        "day",
        "month",
        "year",
        "unknown"
      ],
      "title": "DatePrecision",
      "type": "string"
    },
    "LegacyProvenance": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "authors": {
          "default": "",
          "title": "Authors",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "links": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Links",
          "type": "array"
        },
        "raw": {
          "items": {
            "type": "string"
          },
          "title": "Raw",
          "type": "array"
        }
      },
      "required": [
        "file",
        "line",
        "section",
        "title"
      ],
      "title": "LegacyProvenance",
      "type": "object"
    },
    "LicenseInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "NOASSERTION",
          "title": "Name",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "LicenseInfo",
      "type": "object"
    },
    "PartialDate": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "precision": {
          "$ref": "#/$defs/DatePrecision"
        }
      },
      "required": [
        "value",
        "precision"
      ],
      "title": "PartialDate",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": true,
      "properties": {
        "canonical_source": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Canonical Source",
          "type": "string"
        },
        "discovered_via": {
          "title": "Discovered Via",
          "type": "string"
        },
        "discovered_at": {
          "format": "date",
          "title": "Discovered At",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_metadata": {
          "additionalProperties": true,
          "title": "Source Metadata",
          "type": "object"
        },
        "legacy": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegacyProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "legacy_duplicates": {
          "items": {
            "$ref": "#/$defs/LegacyProvenance"
          },
          "title": "Legacy Duplicates",
          "type": "array"
        }
      },
      "required": [
        "canonical_source",
        "discovered_via",
        "discovered_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Relation",
      "type": "object"
    },
    "ResourceLinks": {
      "additionalProperties": true,
      "properties": {
        "canonical": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Canonical",
          "type": "string"
        },
        "homepage": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Homepage"
        },
        "paper": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper"
        },
        "code": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "model": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "dataset": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset"
        },
        "documentation": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Documentation"
        }
      },
      "required": [
        "canonical"
      ],
      "title": "ResourceLinks",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "code",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "released_at": {
      "$ref": "#/$defs/PartialDate"
    },
    "added_at": {
      "format": "date",
      "title": "Added At",
      "type": "string"
    },
    "last_verified_at": {
      "format": "date",
      "title": "Last Verified At",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "tasks": {
      "items": {
        "type": "string"
      },
      "title": "Tasks",
      "type": "array"
    },
    "modalities": {
      "items": {
        "type": "string"
      },
      "title": "Modalities",
      "type": "array"
    },
    "languages": {
      "items": {
        "type": "string"
      },
      "title": "Languages",
      "type": "array"
    },
    "links": {
      "$ref": "#/$defs/ResourceLinks"
    },
    "license": {
      "$ref": "#/$defs/LicenseInfo"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "title": "Relations",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "curation": {
      "$ref": "#/$defs/Curation"
    },
    "repository": {
      "title": "Repository",
      "type": "string"
    },
    "official": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Official"
    },
    "landmark": {
      "default": false,
      "title": "Landmark",
      "type": "boolean"
    },
    "programming_languages": {
      "items": {
        "type": "string"
      },
      "title": "Programming Languages",
      "type": "array"
    },
    "maintenance_status": {
      "default": "unknown",
      "enum": [
        "active",
        "inactive",
        "archived",
        "unknown"
      ],
      "title": "Maintenance Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "name",
    "released_at",
    "added_at",
    "last_verified_at",
    "links",
    "provenance",
    "curation",
    "repository"
  ],
  "title": "CodeResource",
  "type": "object"
}
